# Copy this file to .env and fill in the values, then:
#   source .env && npx cdk deploy --all
#
# Or export each variable individually before running cdk deploy.

# Bridge API
BRIDGE_API_KEY=
BRIDGE_WEBHOOK_PUBLIC_KEY_PEM=

# Privy
PRIVY_APP_ID=

# Pagination token encryption (generate with: openssl rand -hex 32)
PAGINATION_ENCRYPTION_KEY=
